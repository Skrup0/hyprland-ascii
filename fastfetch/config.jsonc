{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "gentoo",
    "color": { "1": "magenta", "2": "black" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "blue" },
    "key": { "width": 8 }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─" },
    { "type": "os", "key": "os" },
    { "type": "kernel", "key": "kernel" },
    { "type": "packages", "key": "pkgs", "format": "{emerge} (emerge)" },
    { "type": "shell", "key": "shell" },
    { "type": "terminal", "key": "term" },
    { "type": "wm", "key": "wm" },
    "break",
    { "type": "colors", "symbol": "block", "block": { "range": [0, 6], "width": 3 } }
  ]
}
